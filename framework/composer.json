{
  "name": "zaytsev/framework",
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2",
    "nikic/fast-route": "^1.3",
    "psr/container": "^2.0@dev"
  },
  "autoload": {
    "psr-4": {
